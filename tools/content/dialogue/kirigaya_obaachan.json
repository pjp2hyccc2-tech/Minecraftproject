{
 "name": "霧ヶ谷のおばあさん",
 "voice": "old",
 "entries": [
  {
   "id": "hello",
   "priority": 10,
   "lines": [
    "おや、旅の子かい。",
    "霧ヶ谷はなんにもないとこやけど、空気はおいしいよ。"
   ]
  },
  {
   "id": "waiting",
   "priority": 10,
   "lines": [
    "電車を待っとるんよ。町の病院へ行くんやけどね。",
    "山の駅は、電車が来るまで、のんびり待つのがええんよ。"
   ]
  },
  {
   "id": "fog",
   "priority": 10,
   "when": {
    "time": "morning"
   },
   "lines": [
    "朝は、このへん霧でまっ白になるんよ。",
    "霧の中から電車のライトが見えてくると、ほっとするわ。"
   ]
  },
  {
   "id": "mujin_eki",
   "priority": 10,
   "lines": [
    "この駅は、駅員さんのおらん無人駅なんよ。",
    "せやけど、切符はちゃんと買うてから乗るんよ。"
   ]
  },
  {
   "id": "kajika",
   "priority": 10,
   "lines": [
    "耳をすましてごらん。カジカガエルが鳴いとるやろ。",
    "ころころって、鈴みたいなきれいな声やろ。"
   ]
  },
  {
   "id": "hotaru",
   "priority": 10,
   "when": {
    "time": "night"
   },
   "lines": [
    "夏のはじめの夜は、谷川にホタルが飛ぶんよ。",
    "ホタルは、水のきれいなところにしかおらんのよ。"
   ]
  },
  {
   "id": "rain",
   "priority": 10,
   "when": {
    "weather": "rain"
   },
   "lines": [
    "雨の山は、においがちがうやろ。土と葉っぱのにおいや。"
   ]
  },
  {
   "id": "fallback",
   "priority": 10,
   "lines": [
    "気ぃつけて旅しいや。電車の窓から見る山も、ええもんよ。"
   ]
  }
 ]
