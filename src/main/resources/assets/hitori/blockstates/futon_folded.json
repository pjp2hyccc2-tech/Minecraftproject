{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "hitori:block/futon_folded"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "hitori:block/futon_folded",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "hitori:block/futon_folded",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "hitori:block/futon_folded",
        "y": 270
      }
    },
    {
      "when": {
        "shelf": "true"
      },
      "apply": {
        "model": "hitori:block/oshiire_shelf_board"
      }
    }
  ]
}
